{
  "obsidian": 1,
  "id": "alomare.sharedresupply",
  "version": "1.1.0",
  "name": {
    "en": "Shared Resupply"
  },
  "image": "icon.png",
  "description": {
    "en": "Implements the Helldivers 2 resupply: 4 ammo boxes at a 180s cooldown. Box count and native resupply removal are configurable."
  },
  "authors": [
    "Alomare"
  ],
  "scope": "session",
  "every_player": true,
  "entry": "main.lua",
  "source": "https://github.com/Alomare/HD1-SharedResupply",
  "modules": [
    "src/stratagem.lua",
    "src/vanilla.lua",
    "src/payload.lua",
    "src/squad.lua"
  ],
  "requires": [
    "obsidian.api"
  ],
  "resources": [
    {
      "type": "texture",
      "name": "shared_resupply/shared_resupply_icon",
      "bundle": "9cf71054ea26dddf",
      "data": "res/shared_resupply_icon.texture"
    },
    {
      "type": "material",
      "name": "shared_resupply/icons",
      "bundle": "9cf71054ea26dddf",
      "data": "res/icons.material"
    }
  ],
  "options": [
    {
      "id": "preserve_vanilla_resupply",
      "type": "toggle",
      "default": false,
      "label": {
        "en": "Preserve vanilla Resupply"
      },
      "description": {
        "en": "Keep the standard Resupply in the Arsenal and Loadout alongside the shared one."
      }
    },
    {
      "id": "box_count",
      "type": "number",
      "default": 4,
      "min": 2,
      "max": 4,
      "step": 1,
      "label": {
        "en": "Ammo box count"
      },
      "description": {
        "en": "How many ammo boxes the Resupply drops. The setting of the player who calls the Resupply decides."
      }
    }
  ],
  "loader_api": 1
}
